# AIREBO-M polyethylene capability smoke test.
# This adapts the pinned official LAMMPS AIREBO demonstration and cannot emit measurements.

units               metal
atom_style          atomic

read_data           ${data_file}
replicate           4 4 1

neighbor            0.5 bin
neigh_modify        delay 5 every 1

pair_style          airebo/morse 3.0
pair_coeff          * * ${potential_file} C H

velocity            all create 300.0 761341
fix                  integrator all nve
timestep             0.0005

thermo              10
thermo_style        custom step atoms temp pe ke etotal press
run                 100
