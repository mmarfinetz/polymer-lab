clear
units metal
atom_style atomic
boundary p p p
read_restart /vast/projects/jcombar1/betty-testing/mitchmar/polymer-lab/runs/fiber-v1/discovery-v2/reference-validation/crystalline-pe-v1/seed-155921/02_equilibrated.restart
newton on
pair_style airebo/morse 3.0
pair_coeff * * /vast/projects/jcombar1/betty-testing/mitchmar/polymer-lab/vendor/lammps-reference/9e42b6f0f2c68a092d5847d4127a053dc50e126a/CH.airebo-m C H
neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes
timestep 0.0002
reset_timestep 0
run 0
variable initial_lz equal $(lz)
variable engineering_strain equal (lz-v_initial_lz)/v_initial_lz
variable true_strain equal log(lz/v_initial_lz)
variable axial_gpa equal -pzz*0.0001
variable transverse_bar equal (pxx+pyy)/2.0
fix integrator all npt temp 300.0 300.0 0.1 x 0.0 0.0 0.5 y 0.0 0.0 0.5 couple xy
fix axial all deform 1 z erate 0.002 remap x units box
restart 25000 /vast/projects/jcombar1/betty-testing/mitchmar/polymer-lab/runs/fiber-v1/discovery-v2/reference-validation/crystalline-pe-v1/seed-155921/03_tensile.*.restart
thermo 50
thermo_style custom step v_engineering_strain v_true_strain v_axial_gpa temp density v_transverse_bar lx ly lz pxx pyy pzz pe etotal
run 75000
write_restart /vast/projects/jcombar1/betty-testing/mitchmar/polymer-lab/runs/fiber-v1/discovery-v2/reference-validation/crystalline-pe-v1/seed-155921/03_tensile_complete.restart
